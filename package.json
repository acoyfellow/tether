{
  "name": "tether",
  "version": "0.0.1",
  "description": "Draw a line from each thing an agent claims to the exact text that backs it.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "bun eval/site.ts && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "dev": "alchemy dev",
    "deploy": "npm run build && alchemy deploy",
    "lint": "bash scripts/fetch-anti-slop.sh && oxlint -c .oxlintrc.json src client/src eval test"
  },
  "dependencies": {
    "effect": "4.0.0",
    "foldkit": "0.168.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@foldkit/vite-plugin": "0.26.1",
    "@oxlint/plugins": "1.88.0",
    "@tailwindcss/vite": "4.3.3",
    "alchemy": "2.0.0-beta.83",
    "happy-dom": "20.14.6",
    "oxlint": "1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "workerd@1.20261002.1": true
  }
}
